# PostgreSQL used by the Lunowa application and Better Auth session store.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/lunowa

# Generate with a cryptographically secure random source; minimum 32 characters.
BETTER_AUTH_SECRET=

# The externally reachable application origin (no path or trailing slash).
BETTER_AUTH_URL=http://localhost:3000

# Gmail OAuth client. Keep the client secret outside repository data.
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:3000/api/providers/gmail/oauth/callback

# Base64-encoded 32-byte AES key from a runtime secret store. Rotate by version.
GMAIL_CREDENTIAL_KEY=
GMAIL_CREDENTIAL_KEY_VERSION=v1

# Authenticated Pub/Sub push subscription and Gmail users.watch topic.
GMAIL_PUBSUB_AUDIENCE=http://localhost:3000/api/providers/gmail/pubsub
GMAIL_PUBSUB_SERVICE_ACCOUNT=
GMAIL_PUBSUB_TOPIC=projects/example/topics/lunowa-gmail

# High-entropy bearer secret for manual/control-plane worker recovery calls.
GMAIL_WORKER_SECRET=
