{
  "name": "lunowa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cloudflare": "vinext build",
    "check:cloudflare": "vinext check",
    "deploy:cloudflare": "wrangler deploy --config dist/server/wrangler.json",
    "preview:cloudflare": "wrangler versions upload --config dist/server/wrangler.json",
    "check:cloudflare:deploy": "node -e \"require('node:fs').accessSync('dist/server/wrangler.json')\" && WRANGLER_SEND_METRICS=false WRANGLER_NO_SKILLS_UPDATE_PROMPTS=true wrangler deploy --config dist/server/wrangler.json --dry-run",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "test:auth-production": "node --import tsx tests/auth-production-integration.ts",
    "test:evidence-foundation": "node --import tsx tests/evidence-foundation-integration.ts",
    "test:gmail-provider": "vitest run tests/gmail-provider.test.ts",
    "test:gmail-production": "node --import tsx tests/gmail-provider-integration.ts",
    "proof:auth-uuid:schema": "auth generate --config proofs/better-auth-uuid/auth.ts --output proofs/better-auth-uuid/auth-schema.ts --yes && drizzle-kit generate --config proofs/better-auth-uuid/drizzle.config.ts",
    "test:auth-uuid": "node --import tsx tests/better-auth-uuid-proof.ts",
    "proof:responsibility-l2:schema": "drizzle-kit generate --config proofs/responsibility-l2/proof-config.ts && node --import tsx tests/responsibility-l2-schema-check.ts",
    "test:responsibility-l2": "node --import tsx tests/responsibility-l2-proof.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:preview": "playwright test e2e/deployed-preview-smoke.spec.ts",
    "verify": "python -m unittest scripts/test_parallel_task_preflight.py && pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm check:cloudflare && pnpm build:cloudflare && pnpm check:cloudflare:deploy"
  },
  "dependencies": {
    "@vinext/cloudflare": "1.0.0-beta.7",
    "better-auth": "1.7.2",
    "drizzle-orm": "0.45.2",
    "next": "16.3.3",
    "next-intl": "4.13.6",
    "pg": "8.23.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-server-dom-webpack": "19.2.7",
    "vinext": "1.0.0-beta.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.3",
    "@playwright/test": "1.62.1",
    "@types/pg": "8.23.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.34",
    "auth": "1.7.2",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "jsdom": "30.0.1",
    "postcss": "^8.5.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.10",
    "tsx": "4.21.0",
    "wrangler": "4.128.0"
  }
}
